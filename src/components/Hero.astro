---
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { brandCopy } from '../data/site-core';
import { getT } from '../i18n/server';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const useBrandHero = locale === 'en';
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];

const title = useBrandHero ? siteConfig.name : t('hero.accent');
const subtitle = useBrandHero ? productInfo.heroLede : t('hero.subtitle');
const ctaBuy = useBrandHero ? brandCopy.ctaBuy : t('hero.buyNow');
const priceFrom = t('hero.priceFrom');
const priceLabel = priceFrom ? `${priceFrom} $${monthly.price}` : `$${monthly.price}`;
const imageAlt = t('hero.imageAlt', { brand: siteConfig.name });

const chips = [
	{ key: 'chipEsp', edit: 'chipEsp', icon: 'esp', label: useBrandHero ? brandCopy.chipEsp : t('hero.chipEsp') },
	{ key: 'chipAim', edit: 'chipAim', icon: 'aim', label: useBrandHero ? brandCopy.chipAim : t('hero.chipAim') },
	{ key: 'chipRadar', edit: 'chipRadar', icon: 'radar', label: useBrandHero ? brandCopy.chipRadar : t('hero.chipRadar') },
	{
		key: 'chipUpdates',
		edit: 'chipUpdates',
		icon: 'updates',
		label: useBrandHero ? brandCopy.chipUpdates : t('hero.chipUpdates'),
	},
] as const;
---

<section class="hero" aria-label={title}>
	<div class="hero__media">
		<img
			src={heroSrc}
			srcset={heroSrcSet}
			sizes={heroSizes}
			alt={imageAlt}
			width={heroWidth}
			height={heroHeight}
			fetchpriority="high"
			loading="eager"
			decoding="sync"
		/>
	</div>
	<div class="hero__veil" aria-hidden="true"></div>
	<div class="shell hero__content">
		<div class="hero__copy">
			<h1 class="hero__brand">
				{useBrandHero ? <span data-edit="name">{title}</span> : title}
			</h1>
			<p class="hero__lede" data-edit={useBrandHero ? 'heroLede' : undefined}>{subtitle}</p>
			<div class="hero__actions">
				<a class="hero__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
							stroke="currentColor"
							stroke-width="1.7"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					<span class="hero__buy-label" data-edit={useBrandHero ? 'ctaBuy' : undefined}>{ctaBuy}</span>
					<span class="hero__buy-price">{priceLabel}</span>
				</a>
			</div>
			<ul class="hero__features">
				{
					chips.map((chip) => (
						<li>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								{chip.icon === 'esp' && (
									<>
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 8.5v3.2L14.2 14"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.icon === 'aim' && (
									<path
										d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									/>
								)}
								{chip.icon === 'radar' && (
									<>
										<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.icon === 'updates' && (
									<path
										d="M5 13.2l4.2 4.2L19 7.6"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								)}
							</svg>
							<span data-edit={useBrandHero ? chip.edit : undefined}>{chip.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style is:global>
	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
		--hero-ratio: 3.15 / 1;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: #050506;
		aspect-ratio: var(--hero-ratio);
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img {
		object-fit: cover;
		object-position: right 28%;
		image-rendering: auto;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(5, 5, 6, 0.78) 0%,
			rgba(5, 5, 6, 0.52) 34%,
			rgba(5, 5, 6, 0.18) 58%,
			transparent 74%
		);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-block: var(--hero-pad-y);
		align-self: center;
		transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: min(100%, 28rem);
		max-width: 100%;
		min-width: 0;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 3.2vw, 2.65rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--ink);
		text-wrap: balance;
	}

	.hero__lede {
		margin: 0;
		max-width: 28rem;
		color: var(--ink-muted);
		font-size: clamp(0.92rem, 1.35vw, 1.05rem);
		line-height: 1.45;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.15rem;
	}

	.hero__buy {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		padding: 0.55rem 0.95rem 0.55rem 0.85rem;
		border-radius: 0.65rem;
		background: var(--accent);
		color: #0a0a0b;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 28%, transparent);
		transition:
			transform 0.15s ease,
			background 0.15s ease,
			box-shadow 0.15s ease;
	}

	.hero__buy svg {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	.hero__buy-label {
		white-space: nowrap;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 1.55rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: color-mix(in srgb, #0a0a0b 18%, transparent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.hero__buy:hover {
		background: var(--accent-hover, var(--magenta-soft));
		transform: translateY(-1px);
		box-shadow: 0 14px 32px color-mix(in srgb, var(--accent) 34%, transparent);
	}

	.hero__buy:hover .hero__buy-price {
		background: color-mix(in srgb, #0a0a0b 24%, transparent);
	}

	.hero__buy:active {
		transform: translateY(0);
	}

	.hero__features {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.75rem;
		margin: 0.15rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--ink-muted);
		font-size: 0.82rem;
	}

	.hero__features li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.hero__features li span {
		white-space: nowrap;
	}

	.hero__features svg {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--accent);
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}
	}

	@media (max-width: 720px) {
		.hero {
			--hero-ratio: 1.15 / 1;
			min-height: min(72vw, 26rem);
		}

		.hero__media img {
			object-position: 78% 10%;
		}

		.hero__veil {
			background: linear-gradient(
				180deg,
				rgba(5, 5, 6, 0.2) 0%,
				rgba(5, 5, 6, 0.55) 42%,
				rgba(5, 5, 6, 0.88) 100%
			);
		}

		.hero__content {
			align-self: end;
			transform: none;
			padding-block: 1rem 1.15rem;
		}

		.hero__copy {
			width: 100%;
			gap: 0.55rem;
		}

		.hero__brand {
			font-size: clamp(1.55rem, 7.2vw, 2rem);
		}

		.hero__lede {
			font-size: 0.92rem;
			max-width: 22rem;
		}

		.hero__actions {
			width: 100%;
		}

		.hero__buy {
			width: 100%;
			justify-content: center;
		}

		.hero__features {
			gap: 0.35rem 0.65rem;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 420px) {
		.hero__content {
			padding-block: 0.85rem 1rem;
		}

		.hero__brand {
			font-size: 1.45rem;
		}

		.hero__lede {
			font-size: 0.88rem;
		}

		.hero__buy {
			min-height: 2.55rem;
			font-size: 0.9rem;
		}

		.hero__features {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.35rem 0.5rem;
		}
	}
</style>
