---
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { brandCopy } from '../data/site-core';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const t = getT(locale);
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isBlogPath(current);
const useBrand = locale === 'en';

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getBlogLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const homeHref = getLocalizedPath('home', locale);
const currentLocaleMeta = locales.find((l) => l.code === locale) ?? locales[0];

const links = [
	{
		id: 'hacks',
		label: useBrand ? brandCopy.navPreview : t('nav.preview'),
		edit: 'navPreview',
		href: getLocalizedPath('hacks', locale),
		icon: 'M12 3.5l7.5 4.2v8.6L12 20.5l-7.5-4.2V7.7L12 3.5zm0 2.2L6.8 8.5v6.9L12 18.3l5.2-2.9V8.5L12 5.7z',
	},
	{
		id: 'esp',
		label: useBrand ? brandCopy.navFeatures : t('nav.features'),
		edit: 'navFeatures',
		href: getLocalizedPath('features', locale),
		icon: 'M12 5a7 7 0 100 14 7 7 0 000-14zm0 2.2a4.8 4.8 0 110 9.6 4.8 4.8 0 010-9.6zM12 10.2v2.4l1.8 1.1',
	},
	{
		id: 'pricing',
		label: useBrand ? brandCopy.navStore : t('nav.store'),
		edit: 'navStore',
		href: getLocalizedPath('pricing', locale),
		icon: 'M7.5 7.2h9M7.5 12h9M7.5 16.8H14M5 4.8h14a1.2 1.2 0 011.2 1.2v12a1.2 1.2 0 01-1.2 1.2H5A1.2 1.2 0 013.8 18V6A1.2 1.2 0 015 4.8z',
	},
	{
		id: 'updates',
		label: useBrand ? brandCopy.navStatus : t('nav.status'),
		edit: 'navStatus',
		href: getLocalizedPath('updates', locale),
		icon: 'M12 4.2v3.2M12 16.6v3.2M4.2 12h3.2M16.6 12h3.2M7.1 7.1l2.3 2.3M14.6 14.6l2.3 2.3M16.9 7.1l-2.3 2.3M9.4 14.6l-2.3 2.3',
	},
	{
		id: 'reviews',
		label: useBrand ? brandCopy.navReviews : t('nav.reviews'),
		edit: 'navReviews',
		href: reviewsBasePath,
		icon: 'M12 4.5l1.8 4.9H19l-4.1 3.2 1.6 5L12 14.9 7.5 17.6l1.6-5L5 9.4h5.2L12 4.5z',
	},
];

function isActive(href: string) {
	if (href === '/') return current === '/' || current === `/${locale}/`;
	if (href === reviewsBasePath) return current === href || current.startsWith(href);
	return current === href || current.startsWith(href);
}

const buyShort = useBrand ? brandCopy.ctaBuyShort : t('cta.buyShort');
const buyLabel = useBrand ? brandCopy.ctaBuy : t('cta.buy');
---

<header class="site-header" data-nav>
	<div class="shell site-header__bar">
		<a class="site-brand" href={homeHref} data-edit="name">{siteConfig.name}</a>
		<nav class="site-nav" aria-label={t('nav.primaryAria')}>
			{
				links.map((item) => (
					<a href={item.href} class={isActive(item.href) ? 'is-active' : undefined}>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d={item.icon}
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
						<span data-edit={item.edit}>{item.label}</span>
					</a>
				))
			}
		</nav>
		<div class="site-tools">
			<div class="site-tools__lang">
				<details class="lang-switcher">
					<summary class="lang-switcher__toggle" aria-label={t('common.selectLanguage')}>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
							<path
								d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9M12 3c-2.5 2.8-3.8 6-3.8 9s1.3 6.2 3.8 9"
								stroke="currentColor"
								stroke-width="1.6"></path>
						</svg>
						<span>{currentLocaleMeta.nativeName}</span>
					</summary>
					<div class="lang-switcher__panel">
						<p class="lang-switcher__note">
							{locale === 'en' ? t('common.englishOfficial') : t('common.englishIsOfficial')}
						</p>
						<ul class="lang-switcher__list">
							{
								locales.map((l) => (
									<li>
										<a
											href={localeSwitchHref(l.code)}
											hreflang={l.hreflang}
											lang={l.code}
											class:list={['lang-switcher__link', { 'is-current': l.code === locale }]}
											aria-current={l.code === locale ? 'page' : undefined}
											data-locale={l.code}
										>
											<span class="lang-switcher__native">{l.nativeName}</span>
											<span class="lang-switcher__region">{l.region}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</details>
			</div>
			<a
				href={siteConfig.checkoutUrl}
				class="site-tools__buy"
				rel="noopener noreferrer"
				aria-label={buyShort}
			>
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<span data-edit="ctaBuyShort">{buyShort}</span>
			</a>
			<button
				type="button"
				class="site-menu"
				aria-expanded="false"
				aria-controls="site-nav-panel"
				aria-label={t('nav.openMenu')}
				data-nav-toggle
				data-label-open={t('nav.openMenu')}
				data-label-close={t('nav.closeMenu')}
			>
				<span class="site-menu__bars" aria-hidden="true"><span></span><span></span><span></span></span>
			</button>
		</div>
	</div>

	<div class="site-panel" id="site-nav-panel" hidden>
		<div class="shell site-panel__inner">
			<nav class="site-panel__nav" aria-label={t('nav.mobileAria')}>
				{
					links.map((item) => (
						<a href={item.href} class={isActive(item.href) ? 'is-active' : undefined} data-nav-close>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d={item.icon}
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span>{item.label}</span>
						</a>
					))
				}
			</nav>
			<div class="site-panel__foot">
				<a href={siteConfig.checkoutUrl} class="site-panel__buy" rel="noopener noreferrer" data-nav-close>
					<span data-edit="ctaBuy">{buyLabel}</span>
				</a>
			</div>
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const header = document.querySelector('.site-header[data-nav]');
		if (!header) return;
		const toggle = header.querySelector('[data-nav-toggle]');
		const panel = header.querySelector('#site-nav-panel');
		if (!toggle || !panel) return;

		const openLabel = toggle.getAttribute('data-label-open') || 'Open menu';
		const closeLabel = toggle.getAttribute('data-label-close') || 'Close menu';

		const setOpen = (open) => {
			header.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
			panel.hidden = !open;
			document.body.classList.toggle('nav-lock', open);
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		header.querySelectorAll('[data-nav-close]').forEach((el) => {
			el.addEventListener('click', () => setOpen(false));
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
		window.addEventListener(
			'resize',
			() => {
				if (window.matchMedia('(min-width: 1025px)').matches) setOpen(false);
			},
			{ passive: true },
		);
		const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	})();
</script>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
		color: var(--ink);
		border-color: var(--line);
		background: var(--bg-elevated);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__link {
		color: var(--ink);
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.5rem;
	}

	.site-brand {
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		margin-right: auto;
	}

	.site-nav {
		display: none;
		align-items: center;
		gap: 0.15rem;
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.65rem;
		border-radius: 0.55rem;
		color: var(--ink-muted);
		text-decoration: none;
		font-size: 0.86rem;
		font-weight: 600;
	}

	.site-nav a svg {
		width: 0.95rem;
		height: 0.95rem;
	}

	.site-nav a:hover,
	.site-nav a.is-active {
		color: var(--ink);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
	}

	.site-tools {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.site-tools__buy,
	.site-panel__buy {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: var(--accent);
		color: #0a0a0b;
		font-weight: 700;
		font-size: 0.82rem;
		text-decoration: none;
	}

	.site-tools__buy svg {
		width: 1rem;
		height: 1rem;
	}

	.site-menu {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		border: 1px solid var(--line-soft);
		border-radius: 0.55rem;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.site-menu__bars {
		display: grid;
		gap: 0.22rem;
		width: 1rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		background: currentColor;
		border-radius: 99px;
	}

	.site-panel {
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
	}

	.site-panel[hidden] {
		display: none !important;
	}

	.site-panel__inner {
		padding-block: 0.85rem 1.15rem;
	}

	.site-panel__nav {
		display: grid;
		gap: 0.25rem;
	}

	.site-panel__nav a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.8rem 0.7rem;
		border-radius: 0.6rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
	}

	.site-panel__nav a svg {
		width: 1.05rem;
		height: 1.05rem;
		color: var(--accent);
	}

	.site-panel__nav a.is-active,
	.site-panel__nav a:hover {
		background: var(--bg-elevated);
	}

	.site-panel__foot {
		margin-top: 0.85rem;
	}

	.site-panel__buy {
		width: 100%;
		justify-content: center;
		min-height: 2.75rem;
		border-radius: 0.65rem;
	}

	.lang-switcher {
		position: relative;
	}

	.lang-switcher__panel {
		position: absolute;
		padding: 0.55rem;
	}

	.lang-switcher__note {
		margin: 0 0 0.4rem;
		padding: 0 0.35rem;
		color: var(--ink-faint);
		font-size: 0.72rem;
	}

	.lang-switcher__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.15rem;
	}

	.lang-switcher__link {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 0.5rem;
		border-radius: 0.45rem;
		text-decoration: none;
		font-size: 0.82rem;
	}

	.lang-switcher__region {
		color: var(--ink-faint);
		font-size: 0.72rem;
	}

	@media (min-width: 1025px) {
		.site-nav {
			display: inline-flex;
		}

		.site-menu,
		.site-panel {
			display: none !important;
		}
	}
</style>
